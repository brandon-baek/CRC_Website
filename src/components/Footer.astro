---
import { t, localePath, type Locale } from '../i18n';
import { org } from '../data/org';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const dict = t(locale);
const year = new Date().getFullYear();
---
<footer class="site-footer">
  <div class="container">
    <div class="cols">
      <div>
        <img src="/favicon.svg" alt="" width="52" height="52" style="border-radius:10px; margin-bottom:0.9rem;" />
        <h4>{dict.siteName} · <span lang={locale === 'en' ? 'ko' : 'en'}>{dict.siteNameKo}</span></h4>
        <p>{dict.footer.blurb}</p>
        <p
          class="visit-counter mt-1"
          data-visit-counter
          data-locale={locale}
          hidden
          aria-live="polite"
        >
          <span class="visit-counter-dot" aria-hidden="true"></span>
          <span>{dict.footer.visits}</span>
          <span data-visit-count></span>
        </p>
      </div>
      <nav aria-label={dict.footer.quickLinks}>
        <h4>{dict.footer.quickLinks}</h4>
        <ul>
          <li><a href={localePath(locale, '/get-help')}>{dict.nav.getHelp}</a></li>
          <li><a href={localePath(locale, '/directory')}>{dict.nav.directory}</a></li>
          <li><a href={localePath(locale, '/learn')}>{dict.nav.learn}</a></li>
          <li><a href={localePath(locale, '/news')}>{dict.nav.news}</a></li>
        </ul>
      </nav>
      <nav aria-label={dict.footer.resources}>
        <h4>{dict.footer.resources}</h4>
        <ul>
          <li><a href={localePath(locale, '/about')}>{dict.nav.about}</a></li>
          <li><a href={localePath(locale, '/contact')}>{dict.nav.contact}</a></li>
          <li><a href={localePath(locale, '/donate')}>{dict.nav.donate}</a></li>
          <li><a href="https://reportfraud.ftc.gov" rel="noopener">{dict.footer.reportFraud}</a></li>
        </ul>
      </nav>
      <div>
        <h4>{dict.footer.contact}</h4>
        <p>
          {org.addressLine1}<br />
          {org.addressLine2}<br />
          <a class="footer-phone" href={`tel:${org.phoneHref}`}>{org.phoneDisplay}</a>
        </p>
        <p class="mt-1">
          {dict.contact.hoursRows.map((row) => (
            <>{row.day}: {row.time}<br /></>
          ))}
          {dict.contact.hoursClosed}
        </p>
      </div>
    </div>
    <div class="legal">
      <p>{dict.footer.disclaimer}</p>
      <p class="mt-1">© {year} {dict.footer.rights}</p>
    </div>
  </div>
</footer>

<script>
  const SESSION_KEY = 'crc-visit-counted-at';
  const SESSION_LENGTH_MS = 30 * 60 * 1000;

  function hasActiveVisit(): boolean {
    try {
      const countedAt = Number(localStorage.getItem(SESSION_KEY));
      return Number.isFinite(countedAt) && Date.now() - countedAt < SESSION_LENGTH_MS;
    } catch {
      return false;
    }
  }

  function rememberVisit(): void {
    try {
      localStorage.setItem(SESSION_KEY, String(Date.now()));
    } catch {
      // Privacy settings may disable storage; the aggregate counter still works.
    }
  }

  async function loadVisitCounter(): Promise<void> {
    const counter = document.querySelector<HTMLElement>('[data-visit-counter]');
    const countNode = counter?.querySelector<HTMLElement>('[data-visit-count]');
    if (!counter || !countNode) return;

    const shouldCount = !hasActiveVisit();

    try {
      const response = await fetch('/api/visits', {
        method: shouldCount ? 'POST' : 'GET',
        headers: shouldCount ? { 'content-type': 'application/json' } : undefined,
        cache: 'no-store',
      });
      if (!response.ok) return;

      const data = await response.json() as { enabled?: boolean; count?: number };
      if (!data.enabled || !Number.isSafeInteger(data.count) || data.count! < 0) return;

      if (shouldCount) rememberVisit();
      const locale = counter.dataset.locale === 'ko' ? 'ko-KR' : 'en-US';
      countNode.textContent = new Intl.NumberFormat(locale).format(data.count!);
      counter.hidden = false;
    } catch {
      // The counter is decorative; keep it hidden if the service is unavailable.
    }
  }

  void loadVisitCounter();
</script>
