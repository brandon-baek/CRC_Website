---
import Base from '../layouts/Base.astro';
import AgencyCard from '../components/AgencyCard.astro';
import { t, localePath, type Locale } from '../i18n';
import Icon from '../components/Icon.astro';
import { agencyById } from '../data/agencies';
import type { ScamGuide } from '../data/scams';

interface Props {
  locale: Locale;
  guide: ScamGuide;
}
const { locale, guide } = Astro.props;
const dict = t(locale);

// Official English public-service videos plus original Korean CRC productions.
// If a Korean production is missing, fall back to English and say so.
const video = guide.video ? (guide.video[locale] ?? guide.video.en) : null;
const videoIsEnglishOnly = locale === 'ko' && guide.video != null && guide.video.ko == null;
const videoIsLocal = video?.provider === 'local';

const embedSrc = video && !videoIsLocal
  ? video.provider === 'youtube'
    ? `https://www.youtube-nocookie.com/embed/${video.id}?rel=0`
    : `https://player.vimeo.com/video/${video.id}?dnt=1`
  : null;
const localPoster = videoIsLocal ? video.id.replace(/\.mp4$/, '.png') : null;
const localCaptions = videoIsLocal ? video.id.replace(/\.mp4$/, '.ko.vtt') : null;

/** 186 → "3:06" */
function runtime(seconds: number): string {
  return `${Math.floor(seconds / 60)}:${String(seconds % 60).padStart(2, '0')}`;
}

const videoCaption = video
  ? dict.learn.videoBy
      .replace('{source}', video.source[locale])
      .replace('{duration}', runtime(video.seconds))
  : '';

const reportAgencies = guide.reportTo
  .map((id) => agencyById.get(id))
  .filter((a): a is NonNullable<typeof a> => a != null);
---
<Base
  locale={locale}
  title={guide.title[locale]}
  description={guide.tagline[locale]}
  path={`/learn/${guide.slug}`}
>
  <header class="guide-hero">
    <div class="container inner">
      <p>
        <a class="back" href={localePath(locale, '/learn')}>{dict.learn.backToAll}</a>
      </p>
      <h1>{guide.title[locale]}</h1>
      <p class="tagline">{guide.tagline[locale]}</p>
    </div>
  </header>

  <div class="container">
    <div class="guide-body">
      <div>
        <p>{guide.what[locale]}</p>

        <nav class="guide-quick-report" aria-labelledby="quick-report-title">
          <h2 id="quick-report-title">{dict.learn.whereReport}</h2>
          <ul>
            {reportAgencies.map((agency, i) => (
              <li>
                <span>{i === 0 && <span class="badge primary">{dict.wizard.recommended}</span>}{agency.name[locale]}</span>
                <a href={agency.url} rel="noopener">{dict.wizard.visit}<Icon name="external" size={16} /></a>
              </li>
            ))}
          </ul>
          <a class="btn primary" href={localePath(locale, '/get-help')}>{dict.hero.ctaPrimary}</a>
        </nav>

        {video && (
          <section class="guide-section mt-3">
            <h2>{dict.learn.videoTitle}</h2>
            <div class="video-embed">
              {videoIsLocal ? (
                <video
                  controls
                  preload="metadata"
                  poster={localPoster ?? undefined}
                  aria-label={`${guide.title[locale]} — ${dict.learn.videoTitle}`}
                >
                  <source src={video.id} type="video/mp4" />
                  <track
                    kind="captions"
                    src={localCaptions ?? undefined}
                    srclang="ko"
                    label="한국어"
                  />
                  {dict.learn.videoUnsupported}
                </video>
              ) : (
                <iframe
                  src={embedSrc ?? undefined}
                  title={`${guide.title[locale]} — ${dict.learn.videoTitle}`}
                  loading="lazy"
                  allow="fullscreen; picture-in-picture"
                  referrerpolicy="strict-origin-when-cross-origin"
                  allowfullscreen
                ></iframe>
              )}
            </div>
            <p class="video-note">
              {videoCaption}
              {videoIsEnglishOnly && ` ${dict.learn.videoNoteEn}`}
              {' '}
              <a href={video.page} target="_blank" rel="noopener">
                {videoIsLocal ? dict.learn.videoOpenLocal : dict.learn.videoOpen}
                <Icon name="external" size={14} />
              </a>
            </p>
          </section>
        )}

        <section class="guide-section mt-3">
          <h2>{dict.learn.warning}</h2>
          <ul>
            {guide.warningSigns[locale].map((item) => <li>{item}</li>)}
          </ul>
        </section>

        <section class="guide-section">
          <h2>{dict.learn.protect}</h2>
          <ul>
            {guide.protect[locale].map((item) => <li>{item}</li>)}
          </ul>
        </section>

        <section class="guide-section">
          <h2>{dict.learn.ifHappened}</h2>
          <ol>
            {guide.ifHappened[locale].map((item) => <li>{item}</li>)}
          </ol>
        </section>

        <p class="mt-3">
          <a class="btn outline" href={localePath(locale, '/learn')}>
            {dict.learn.backToAll}
          </a>
        </p>
      </div>

      <aside class="guide-aside">
        <section class="guide-section">
          <h2>{dict.learn.whereReport}</h2>
          <ul class="result-list">
            {
              reportAgencies.map((agency, i) => (
                <li>
                  <AgencyCard
                    agency={agency}
                    locale={locale}
                    primary={i === 0}
                    badge={i === 0 ? 'primary' : 'also'}
                  />
                </li>
              ))
            }
          </ul>
          <p class="mt-2">
            <a class="btn primary" href={localePath(locale, '/get-help')}>{dict.hero.ctaPrimary}</a>
          </p>
        </section>
      </aside>
    </div>
  </div>
</Base>
