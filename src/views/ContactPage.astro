---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import IntakeForm from '../components/IntakeForm.astro';
import { t, type Locale } from '../i18n';
import { org, orgAddress, orgMapUrl } from '../data/org';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const dict = t(locale);

---
<Base
  locale={locale}
  title={dict.contact.pageTitle}
  description={dict.contact.pageLede}
  path="/contact"
>
  <!-- 1. Header -->
  <section class="section warm tight">
    <div class="container">
      <div class="section-head" style="margin-bottom:0;">
        <h1>{dict.contact.pageTitle}</h1>
        <p class="muted mt-2" style="font-size:var(--fs-md);">{dict.contact.pageLede}</p>
      </div>
    </div>
  </section>

  <!-- 2. Direct contact + optional online form -->
  <section class="section">
    <div class="container">
      <div class="contact-layout">
        <div class="contact-direct">
          <h2>{dict.contact.infoTitle}</h2>
          <div class="contact-details mt-2">
            <p class="contact-row">
              <Icon name="phone" />
              <strong>{dict.contact.phone}</strong>
              <a href={`tel:${org.phoneHref}`}>{org.phoneDisplay}</a>
            </p>
            <p class="contact-row mt-2">
              <Icon name="map-pin" />
              <strong>{dict.contact.officeLabel}</strong>
              <a href={orgMapUrl} rel="noopener">{orgAddress}</a>
            </p>
            <p class="contact-row mt-2">
              <Icon name="clock" />
              <strong>{dict.contact.hoursLabel}</strong>
              <span>
                {dict.contact.hoursRows.map((row) => (
                  <>{row.day}: {row.time}<br /></>
                ))}
              </span>
            </p>
            <p class="muted mt-1" style="font-size:var(--fs-sm);">{dict.contact.hoursClosed}</p>
          </div>
          <div class="notice red mt-2">
            <Icon name="alert" />
            <p>{dict.hero.urgent}</p>
          </div>
        </div>
        <div id="online-contact">
          <h2>{dict.contact.formTitle}</h2>
          <p class="muted mt-1" style="font-size:var(--fs-sm);">{dict.intake.lede}</p>
          <div class="mt-3">
            <IntakeForm locale={locale} page="contact" />
          </div>
        </div>
      </div>
    </div>
  </section>
</Base>
