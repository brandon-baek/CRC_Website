---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import { t, type Locale } from '../i18n';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const dict = t(locale);

---
<Base
  locale={locale}
  title={dict.contact.pageTitle}
  description={dict.contact.pageLede}
  path="/contact"
>
  <!-- 1. Header -->
  <section class="section warm tight">
    <div class="container">
      <div class="section-head" style="margin-bottom:0;">
        <h1>{dict.contact.pageTitle}</h1>
        <p class="muted mt-2" style="font-size:var(--fs-md);">{dict.contact.pageLede}</p>
      </div>
    </div>
  </section>

  <!-- 2. Form + direct contact -->
  <section class="section">
    <div class="container">
      <div class="grid cols-2" style="align-items:start;">
        <div>
          <h2>{dict.contact.formTitle}</h2>
          <div class="notice mt-2">
            <Icon name="alert" />
            <div>
              <strong>{dict.contact.comingSoon}</strong>
              <p>{dict.contact.comingSoonBody}</p>
            </div>
          </div>
          <!-- INTAKE FORM PLACEHOLDER: when ready, remove `disabled` attributes and wire this form to a form service (e.g. Formspree action URL) or a Cloudflare Pages Function. See README. -->
          <form class="mt-3" aria-disabled="true">
            <div class="field">
              <label for="contact-name">{dict.contact.name}</label>
              <input class="input" id="contact-name" name="name" type="text" disabled />
            </div>
            <div class="field">
              <label for="contact-email">{dict.contact.email}</label>
              <input class="input" id="contact-email" name="email" type="text" disabled />
            </div>
            <div class="field">
              <label for="contact-topic">{dict.contact.topic}</label>
              <select class="input" id="contact-topic" name="topic" disabled>
                {dict.contact.topicOptions.map((option) => <option>{option}</option>)}
              </select>
            </div>
            <div class="field">
              <label for="contact-message">{dict.contact.message}</label>
              <textarea class="input" id="contact-message" name="message" aria-describedby="contact-message-hint" disabled></textarea>
              <p class="hint" id="contact-message-hint">{dict.contact.messageHint}</p>
            </div>
            <button class="btn primary" type="submit" disabled>{dict.contact.submit}</button>
          </form>
        </div>
        <div>
          <h2>{dict.contact.infoTitle}</h2>
          <div class="card mt-2">
            <p class="contact-row">
              <Icon name="phone" />
              <strong>{dict.contact.phone}</strong>
              <span class="placeholder-tag">(213) 555-0100</span>
            </p>
            <p class="contact-row mt-2">
              <Icon name="mail" />
              <strong>{dict.contact.emailLabel}</strong>
              <span class="placeholder-tag">help@crcenter.org</span>
            </p>
            <p class="contact-row mt-2">
              <Icon name="map-pin" />
              <strong>{dict.contact.addressLabel}</strong>
              <span class="placeholder-tag">1234 Wilshire Blvd, Suite 500, Los Angeles, CA 90010</span>
            </p>
            <p class="contact-row mt-2">
              <Icon name="clock" />
              <strong>{dict.contact.hoursLabel}</strong>
              {dict.contact.hoursValue}
            </p>
          </div>
          <div class="notice red mt-2">
            <Icon name="alert" />
            <p>{dict.hero.urgent}</p>
          </div>
        </div>
      </div>
    </div>
  </section>
</Base>
