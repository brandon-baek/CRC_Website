---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import OfficeCards from '../components/OfficeCards.astro';
import { t, localePath, type Locale } from '../i18n';
import { scamGuides } from '../data/scams';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const dict = t(locale);

const featuredGuides = scamGuides.slice(0, 4);
const chipColors = ['red', 'yellow', '', 'red'];
---
<Base locale={locale} title={dict.siteName} description={dict.hero.lede} path="/">
  <!-- 1. Hero -->
  <section class="hero">
    <div class="container">
      <div class="inner">
        <div>
          <h1>
            {dict.hero.title1}<br />
            <span class="underline">{dict.hero.title2}</span>
          </h1>
          <p class="lede">{dict.hero.lede}</p>
          <div class="actions">
            <a class="btn dark big" href={localePath(locale, '/get-help')}>
              {dict.hero.ctaPrimary}
              <Icon name="arrow-right" />
            </a>
            <a class="btn outline big" href={localePath(locale, '/learn')}>
              {dict.hero.ctaSecondary}
            </a>
          </div>
          <div class="notice red mt-3">
            <Icon name="alert" />
            <p>{dict.hero.urgent}</p>
          </div>
        </div>
        <div class="art" aria-hidden="true">
          <div class="sq-motif">
            <span style="background:var(--red)"></span>
            <span class="label">한인<br />시민센터</span>
            <span style="background:var(--yellow)"></span>
            <span style="background:var(--red)"></span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 2. What we do (asymmetric split) -->
  <section class="section">
    <div class="container">
      <div class="section-head">
        <h2>{dict.home.whatTitle}</h2>
      </div>
      <div class="feature-lead">
        <div class="major">
          <h3>{dict.home.what1Title}</h3>
          <p>{dict.home.what1Body}</p>
          <a class="btn lime" href={localePath(locale, '/get-help')}>
            {dict.hero.ctaPrimary}
            <Icon name="arrow-right" size={18} />
          </a>
        </div>
        <div class="minors">
          <div class="card">
            <div class="icon-chip yellow" aria-hidden="true">
              <Icon name="book" size={26} />
            </div>
            <h3>{dict.home.what2Title}</h3>
            <p>{dict.home.what2Body}</p>
          </div>
          <div class="card">
            <div class="icon-chip" aria-hidden="true">
              <Icon name="chat" size={26} />
            </div>
            <h3>{dict.home.what3Title}</h3>
            <p>{dict.home.what3Body}</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 3. Three rules -->
  <section class="section warm">
    <div class="container">
      <div class="section-head">
        <h2>{dict.home.rulesTitle}</h2>
        <p class="sub">{dict.home.rulesSub}</p>
      </div>
      <ol class="rules">
        <li>
          <strong>{dict.home.rule1Title}</strong>
          <p>{dict.home.rule1Body}</p>
        </li>
        <li>
          <strong>{dict.home.rule2Title}</strong>
          <p>{dict.home.rule2Body}</p>
        </li>
        <li>
          <strong>{dict.home.rule3Title}</strong>
          <p>{dict.home.rule3Body}</p>
        </li>
      </ol>
    </div>
  </section>

  <!-- 4. How it works (vertical rail) + stats -->
  <section class="section">
    <div class="container">
      <div class="grid cols-2" style="gap:3rem;align-items:start;">
        <div>
          <div class="section-head">
            <h2>{dict.home.howTitle}</h2>
          </div>
          <ol class="steps">
            <li>
              <strong>{dict.home.how1Title}</strong>
              <p>{dict.home.how1Body}</p>
            </li>
            <li>
              <strong>{dict.home.how2Title}</strong>
              <p>{dict.home.how2Body}</p>
            </li>
            <li>
              <strong>{dict.home.how3Title}</strong>
              <p>{dict.home.how3Body}</p>
            </li>
          </ol>
        </div>
        <div>
          <div class="section-head">
            <h2>{dict.home.statsTitle}</h2>
          </div>
          <div style="display:grid;gap:1.6rem;">
            <div class="stat">
              <div class="num">{dict.home.stat1Num}</div>
              <div class="lbl">{dict.home.stat1Lbl}</div>
            </div>
            <div class="stat">
              <div class="num">{dict.home.stat2Num}</div>
              <div class="lbl">{dict.home.stat2Lbl}</div>
            </div>
            <div class="stat">
              <div class="num">{dict.home.stat3Num}</div>
              <div class="lbl">{dict.home.stat3Lbl}</div>
            </div>
          </div>
          <p class="stats-src">{dict.home.statsSrc}</p>
        </div>
      </div>
    </div>
  </section>

  <!-- 5. Learn preview -->
  <section class="section lime">
    <div class="container">
      <div class="section-head">
        <h2>{dict.home.learnTitle}</h2>
      </div>
      <div class="grid cols-2">
        {featuredGuides.map((guide, i) => (
          <a class="card-hover" href={localePath(locale, `/learn/${guide.slug}`)}>
            <article class="card">
              <div class:list={['icon-chip', chipColors[i % chipColors.length]]} aria-hidden="true">
                <Icon name={guide.icon as any} size={26} />
              </div>
              <h3>{guide.title[locale]}</h3>
              <p>{guide.tagline[locale]}</p>
              <span style="font-weight:700;display:inline-flex;align-items:center;gap:0.4em;" class="mt-2">
                {dict.learn.readGuide}
                <Icon name="arrow-right" size={18} />
              </span>
            </article>
          </a>
        ))}
      </div>
      <div class="center mt-3">
        <a class="btn dark" href={localePath(locale, '/learn')}>{dict.home.learnMore}</a>
      </div>
    </div>
  </section>

  <!-- 6. Directory teaser -->
  <section class="section">
    <div class="container">
      <div class="grid cols-2" style="align-items:center;">
        <div>
          <div class="section-head" style="margin-bottom:0;">
            <h2>{dict.home.dirTitle}</h2>
          </div>
          <p class="mt-2">{dict.home.dirBody}</p>
          <div class="mt-3">
            <a class="btn outline" href={localePath(locale, '/directory')}>{dict.home.dirCta}</a>
          </div>
        </div>
        <div aria-hidden="true" style="justify-self:center;width:min(240px,55vw);transform:rotate(-2deg);">
          <div class="sq-motif">
            <span style="background:var(--yellow)"></span>
            <span style="background:var(--red)"></span>
            <span style="background:var(--lime)"></span>
            <span style="background:var(--paper);border:1px solid var(--line)"></span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 7. Location -->
  <section class="section warm tight">
    <div class="container">
      <div class="section-head">
        <h2>{dict.home.locTitle}</h2>
      </div>
      <OfficeCards locale={locale} />
    </div>
  </section>
</Base>
