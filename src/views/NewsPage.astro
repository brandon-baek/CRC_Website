---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import { t, localePath, type Locale } from '../i18n';
import { fetchAllNews, type NewsSource } from '../data/newsFeeds';
import { sortedPressPosts } from '../data/press';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const dict = t(locale);

// Fetched once at build time; see src/data/newsFeeds.ts.
const { items, liveSources } = await fetchAllNews();

const sourceById = new Map<string, NewsSource>(liveSources.map((s) => [s.id, s]));

const dateFormat = new Intl.DateTimeFormat(locale === 'ko' ? 'ko-KR' : 'en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
const formatDate = (iso: string) => dateFormat.format(new Date(iso));
---
<Base
  locale={locale}
  title={dict.news.pageTitle}
  description={dict.news.pageLede}
  path="/news"
>
  <!-- 1. Header -->
  <section class="section warm tight">
    <div class="container">
      <div class="section-head" style="margin-bottom:0;">
        <h1>{dict.news.pageTitle}</h1>
        <p class="muted mt-2" style="font-size:var(--fs-md);">{dict.news.pageLede}</p>
      </div>
    </div>
  </section>

  <!-- 2. Agency feeds, filterable by source -->
  <section class="section">
    <div class="container">
      <div class="section-head">
        <h2>{dict.news.feedTitle}</h2>
        <p class="muted mt-1" style="font-size:var(--fs-sm);">
          {dict.news.feedLede}
          {/* Only set on the Korean page: these articles are all in English. */}
          {dict.news.englishNote && <> <span>{dict.news.englishNote}</span></>}
        </p>
      </div>

      {items.length > 0 ? (
        <>
          <div class="dir-chips" role="group" aria-label={dict.news.filterLabel}>
            <button type="button" class="chip" data-source="" aria-pressed="true">
              {dict.news.all}
            </button>
            {liveSources.map((source) => (
              <button type="button" class="chip" data-source={source.id} aria-pressed="false">
                {source.label[locale]}
              </button>
            ))}
          </div>

          <ul class="news-list mt-3" id="news-list">
            {items.map((item) => {
              const source = sourceById.get(item.sourceId);
              return (
                <li class="news-item" data-source={item.sourceId}>
                  <p class="date">
                    <span class="badge plain">{source?.label[locale]}</span>
                    {item.date && <span>{formatDate(item.date)}</span>}
                    {source?.linksToPdf && <span class="badge plain">{dict.news.pdf}</span>}
                  </p>
                  <h3>
                    <a href={item.url} target="_blank" rel="noopener" hreflang="en" lang="en">
                      {item.title}
                    </a>
                  </h3>
                  {item.summary && <p lang="en">{item.summary}</p>}
                </li>
              );
            })}
          </ul>

          <p class="mt-3 news-sources">
            {liveSources.map((source) => (
              <a class="btn outline" href={source.homepage} target="_blank" rel="noopener">
                {source.label[locale]}
                <Icon name="external" size={16} />
              </a>
            ))}
          </p>
        </>
      ) : (
        <div class="notice">
          <Icon name="alert" />
          <p>{dict.news.empty}</p>
        </div>
      )}
    </div>
  </section>

  <!-- 3. CRC press releases -->
  <section class="section warm">
    <div class="container">
      <div class="section-head">
        <h2>{dict.news.pressTitle}</h2>
        <p class="muted mt-1" style="font-size:var(--fs-sm);">{dict.news.pressLede}</p>
      </div>

      {sortedPressPosts.length > 0 ? (
        <ul class="news-list">
          {sortedPressPosts.map((post) => (
            <li class="news-item">
              <p class="date">{formatDate(post.date)}</p>
              <h3>
                {post.url ? <a href={post.url}>{post.title[locale]}</a> : post.title[locale]}
              </h3>
              <p>{post.summary[locale]}</p>
            </li>
          ))}
        </ul>
      ) : (
        <div class="card">
          <p class="contact-row">
            <Icon name="newspaper" />
            <span class="muted">{dict.news.pressEmpty}</span>
          </p>
          <p class="mt-2">
            <a class="btn ghost" href={localePath(locale, '/contact')}>
              {dict.nav.contact}
              <Icon name="arrow-right" size={16} />
            </a>
          </p>
        </div>
      )}
    </div>
  </section>

  <script>
    /* Same chip-filter approach as the directory: everything is rendered at
       build time and the script only toggles visibility, so the full list is
       still there with JavaScript off. */
    const chips = document.querySelector('.dir-chips');
    const list = document.getElementById('news-list');
    if (chips && list) {
      const buttons = Array.from(chips.querySelectorAll('.chip'));
      const entries = Array.from(list.querySelectorAll<HTMLElement>('[data-source]'));

      chips.addEventListener('click', (event) => {
        const chip = (event.target as HTMLElement).closest('.chip');
        if (!chip) return;
        const active = chip.getAttribute('data-source') || '';
        buttons.forEach((b) => b.setAttribute('aria-pressed', b === chip ? 'true' : 'false'));
        for (const entry of entries) {
          entry.hidden = Boolean(active) && entry.getAttribute('data-source') !== active;
        }
      });
    }
  </script>
</Base>
