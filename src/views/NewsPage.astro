---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import { t, type Locale } from '../i18n';
import { fetchAllNews, newsSources } from '../data/newsFeeds';
import { featuredArticleImage } from '../data/newsDuplicates';
import { localizedNews, featuredNews, newsTopic, newsTopics } from '../data/newsPresentation';
import { sortedPressPosts } from '../data/press';
import '../styles/news.css';
interface Props { locale: Locale; }
const { locale } = Astro.props;
const copy = t(locale).news;
const { items: allItems } = await fetchAllNews();
const items = localizedNews(allItems, newsSources, locale);
const sourceById = new Map(newsSources.map((source) => [source.id, source]));
const sources = newsSources.filter((source) => items.some((item) => item.sourceId === source.id));
const availableTopics = newsTopics.filter((topic) => items.some((item) => newsTopic(item.title).id === topic.id));
const featured = featuredNews(items);
const images = await Promise.all(featured.map((item) => featuredArticleImage(item, sourceById.get(item.sourceId)!)));
const moreHeadlines = items.filter((item) => !featured.includes(item)).slice(0, 4);
const dateFormat = new Intl.DateTimeFormat(locale === 'ko' ? 'ko-KR' : 'en-US', { year: 'numeric', month: 'short', day: 'numeric', timeZone: 'UTC' });
const formatDate = (iso: string) => dateFormat.format(new Date(iso));
const sourceName = (item: typeof items[number]) => item.publisher ?? sourceById.get(item.sourceId)?.label[locale];
---
<Base locale={locale} title={copy.pageTitle} description={copy.pageLede} path="/news">
  <section class="section crc-news-top"><div class="container">
    <header class="crc-news-heading"><h1>{copy.pageTitle}</h1><span class="crc-news-rule" aria-hidden="true"></span><p class="muted">{copy.feedLede}</p></header>
    {items.length > 0 ? <div class="crc-news-feature-grid">
      {featured.map((item, index) => {
        const topic = newsTopic(item.title);
        return <article class="crc-news-card">
          <div class={`crc-news-art topic-${topic.id}`} aria-hidden="true">
            <Icon name={topic.icon} size={66} />
            {images[index] && <img src={images[index]!} alt="" width="600" height="340" loading="lazy" referrerpolicy="no-referrer" data-news-photo />}
            <span class="crc-news-topic">{topic[locale]}</span>
          </div>
          <div class="crc-news-card-body">
            <h2><a href={item.url} target="_blank" rel="noopener noreferrer" lang={locale} hreflang={locale}>{item.title}</a></h2>
            <p class="crc-news-card-note">{copy.readAt.replace('{source}', sourceName(item) ?? '')}</p>
            <div class="crc-news-card-meta"><span>{sourceName(item)}</span>{item.date && <time datetime={item.date}>{formatDate(item.date)}</time>}</div>
          </div>
        </article>;
      })}
      {moreHeadlines.length > 0 && <aside class="crc-news-sidebar" aria-labelledby="more-headlines-title">
        <h2 id="more-headlines-title">{copy.moreHeadlines}</h2><ol>
          {moreHeadlines.map((item, index) => <li><span class="crc-news-number" aria-hidden="true">{index + 1}</span><div>
            <a href={item.url} target="_blank" rel="noopener noreferrer" lang={locale}>{item.title}</a>
            <p>{sourceName(item)}{item.date && <> · <time datetime={item.date}>{formatDate(item.date)}</time></>}</p>
          </div></li>)}
        </ol>
      </aside>}
    </div> : <div class="notice"><Icon name="alert" /><p>{copy.empty}</p></div>}
  </div></section>

  {items.length > 0 && <section class="section crc-news-library" aria-labelledby="all-news-title"><div class="container" data-news-browser>
    <h2 id="all-news-title">{copy.allNews}</h2>
    <div class="crc-news-filters" role="group" aria-label={copy.topicFilter}>
      <button type="button" class="chip" data-topic="" aria-pressed="true">{copy.all}</button>
      {availableTopics.map((topic) => <button type="button" class="chip" data-topic={topic.id} aria-pressed="false">{topic[locale]}</button>)}
    </div>
    <div class="crc-news-controls">
      <div class="crc-news-search"><label for="news-search">{copy.searchLabel}</label><div><Icon name="search" size={20} /><input type="search" id="news-search" placeholder={copy.searchPlaceholder} autocomplete="off" /></div></div>
      <div class="crc-news-source-select"><label for="news-source">{copy.sourceColumn}</label><select id="news-source"><option value="">{copy.allSources}</option>{sources.map((source) => <option value={source.id}>{source.label[locale]}</option>)}</select></div>
    </div>
    <p class="crc-news-count" id="news-count" aria-live="polite" data-template={copy.showing}>{copy.showing.replace('{n}', String(items.length)).replace('{total}', String(items.length))}</p>
    <table class="crc-news-table">
      <caption class="sr-only">{copy.allNews}</caption>
      <thead><tr><th scope="col">{copy.categoryColumn}</th><th scope="col">{copy.headlineColumn}</th><th scope="col">{copy.sourceColumn}</th><th scope="col">{copy.dateColumn}</th></tr></thead>
      <tbody>{items.map((item) => {
        const topic = newsTopic(item.title);
        return <tr data-news-row data-category={topic.id} data-source={item.sourceId} data-search={`${item.title} ${sourceName(item)} ${topic[locale]}`}>
          <td class="crc-news-category"><span class={`crc-news-tag topic-${topic.id}`}>{topic[locale]}</span></td>
          <td class="crc-news-headline"><a href={item.url} target="_blank" rel="noopener noreferrer" lang={locale} hreflang={locale}>{item.title}</a>{sourceById.get(item.sourceId)?.linksToPdf && <span class="crc-news-pdf">{copy.pdf}</span>}</td>
          <td class="crc-news-source">{sourceName(item)}</td>
          <td class="crc-news-date">{item.date ? <time datetime={item.date}>{formatDate(item.date)}</time> : '—'}</td>
        </tr>;
      })}</tbody>
    </table>
    <p class="notice mt-2" data-news-empty hidden>{copy.noMatches}</p>
    <div class="center mt-3"><button type="button" class="btn outline" data-news-more hidden>{copy.showMore}</button></div>
    <details class="crc-news-source-links"><summary>{copy.visitSources}</summary><div class="news-sources mt-2">{sources.map((source) => <a class="btn outline" href={source.homepage} target="_blank" rel="noopener noreferrer">{source.label[locale]}<Icon name="external" size={16} /></a>)}</div></details>
  </div></section>}
  {items.length === 0 && <section class="section"><div class="container news-sources">{newsSources.filter((source) => (source.lang ?? 'en') === locale).map((source) => <a class="btn outline" href={source.homepage} target="_blank" rel="noopener noreferrer">{source.label[locale]}</a>)}</div></section>}
  {sortedPressPosts.length > 0 && <section class="section warm"><div class="container"><h2>{copy.pressTitle}</h2><p class="muted mt-1">{copy.pressLede}</p>
    <ul class="news-list mt-3">{sortedPressPosts.map((post) => <li class="news-item"><p class="date">{formatDate(post.date)}</p><h3>{post.url ? <a href={post.url}>{post.title[locale]}</a> : post.title[locale]}</h3><p>{post.summary[locale]}</p></li>)}</ul>
  </div></section>}
  <script>
    import { matchesNewsFilter } from '../data/newsPresentation';
    document.querySelectorAll<HTMLImageElement>('[data-news-photo]').forEach((image) => {
      const fallback = () => { image.hidden = true; };
      image.addEventListener('error', fallback);
      if (image.complete && image.naturalWidth === 0) fallback();
    });
    const browser = document.querySelector<HTMLElement>('[data-news-browser]');
    if (browser) {
      const rows = Array.from(browser.querySelectorAll<HTMLTableRowElement>('[data-news-row]'));
      const buttons = Array.from(browser.querySelectorAll<HTMLButtonElement>('[data-topic]'));
      const search = browser.querySelector<HTMLInputElement>('#news-search')!;
      const source = browser.querySelector<HTMLSelectElement>('#news-source')!;
      const count = browser.querySelector<HTMLElement>('#news-count')!;
      const empty = browser.querySelector<HTMLElement>('[data-news-empty]')!;
      const more = browser.querySelector<HTMLButtonElement>('[data-news-more]')!;
      const pageSize = 12;
      let category = '';
      let limit = pageSize;
      function apply() {
        const matching = rows.filter((row) => matchesNewsFilter(row.dataset.search ?? '', row.dataset.category ?? '', row.dataset.source ?? '', search.value, category, source.value));
        const visible = new Set(matching.slice(0, limit));
        rows.forEach((row) => { row.hidden = !visible.has(row); });
        count.textContent = (count.dataset.template ?? '{n} / {total}').replace('{n}', String(visible.size)).replace('{total}', String(matching.length));
        empty.hidden = matching.length > 0;
        more.hidden = limit >= matching.length;
      }
      buttons.forEach((button) => button.addEventListener('click', () => {
        category = button.dataset.topic ?? '';
        buttons.forEach((other) => other.setAttribute('aria-pressed', String(other === button)));
        limit = pageSize;
        apply();
      }));
      search.addEventListener('input', () => { limit = pageSize; apply(); });
      source.addEventListener('change', () => { limit = pageSize; apply(); });
      more.addEventListener('click', () => { limit += pageSize; apply(); });
      apply();
    }
  </script>
</Base>
