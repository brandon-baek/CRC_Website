---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import { t, type Locale } from '../i18n';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const dict = t(locale);
---
<Base
  locale={locale}
  title={dict.about.pageTitle}
  description={dict.about.missionBody2}
  path="/about"
>
  <!-- 1. Mission header -->
  <section class="section warm">
    <div class="container">
      <p class="eyebrow">{dict.about.missionEyebrow}</p>
      <h1 style="font-size:var(--fs-2xl);max-width:26ch;">{dict.about.missionTitle}</h1>
      <p class="muted mt-2" style="font-size:var(--fs-md);">{dict.about.missionBody1}</p>
      <p class="mt-2">{dict.about.missionBody2}</p>
    </div>
  </section>

  <!-- 2. Who we are -->
  <section class="section">
    <div class="container">
      <div class="grid cols-2">
        <div>
          <div class="section-head" style="margin-bottom:0;">
            <h2>{dict.about.whoTitle}</h2>
          </div>
          <p class="mt-2">{dict.about.whoBody}</p>
        </div>
        <div class="notice">
          <Icon name="shield" />
          <p>{dict.footer.disclaimer}</p>
        </div>
      </div>
    </div>
  </section>

  <!-- 3. Team -->
  <section class="section tight">
    <div class="container">
      <div class="section-head">
        <h2>{dict.about.teamTitle}</h2>
      </div>
      <!-- PLACEHOLDER: team bios -->
      <div class="card">
        <p class="muted">{dict.about.teamPlaceholder}</p>
      </div>
    </div>
  </section>

  <!-- 4. Locations & hours -->
  <!-- PLACEHOLDER: replace with real locations -->
  <section class="section warm">
    <div class="container">
      <div class="section-head">
        <h2>{dict.about.locTitle}</h2>
      </div>
      <div class="grid cols-2">
        <div class="card">
          <h3><span class="placeholder-tag">Main Office, Los Angeles</span></h3>
          <p class="contact-row mt-2">
            <Icon name="map-pin" />
            <span class="placeholder-tag">1234 Wilshire Blvd, Suite 500, Los Angeles, CA 90010</span>
          </p>
          <p class="contact-row mt-1">
            <Icon name="phone" />
            <span class="placeholder-tag">(213) 555-0100</span>
          </p>
        </div>
        <div class="card">
          <h3><span class="placeholder-tag">Branch Office, Orange County</span></h3>
          <p class="contact-row mt-2">
            <Icon name="map-pin" />
            <span class="placeholder-tag">5678 Beach Blvd, Suite 200, Buena Park, CA 90621</span>
          </p>
          <p class="contact-row mt-1">
            <Icon name="phone" />
            <span class="placeholder-tag">(714) 555-0100</span>
          </p>
        </div>
      </div>
      <p class="contact-row mt-3">
        <Icon name="clock" />
        <strong>{dict.contact.hoursLabel}</strong>
        <span class="placeholder-tag">{dict.contact.hoursValue}</span>
      </p>
    </div>
  </section>
</Base>
