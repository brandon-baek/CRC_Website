---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import { t, localePath, type Locale } from '../i18n';
import { org } from '../data/org';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const dict = t(locale);

const ways = [
  { icon: 'book' as const, title: dict.donate.way1Title, body: dict.donate.way1Body, cta: dict.donate.way1Cta, href: localePath(locale, '/learn') },
  { icon: 'users' as const, title: dict.donate.way2Title, body: dict.donate.way2Body, cta: dict.donate.way2Cta, href: localePath(locale, '/contact') },
  { icon: 'chat' as const, title: dict.donate.way3Title, body: dict.donate.way3Body, cta: dict.donate.way3Cta, href: localePath(locale, '/contact') },
];
---
<Base
  locale={locale}
  title={dict.donate.pageTitle}
  description={dict.donate.pageLede}
  path="/donate"
>
  <!-- 1. Header -->
  <section class="section warm tight">
    <div class="container">
      <div class="section-head" style="margin-bottom:0;">
        <h1>{dict.donate.pageTitle}</h1>
        <p class="muted mt-2" style="font-size:var(--fs-md);max-width:52ch;">{dict.donate.pageLede}</p>
      </div>
    </div>
  </section>

  <!-- 2. Current giving status -->
  <section class="section tight">
    <div class="container">
      <div class="notice lime">
        <Icon name="heart" />
        <div>
          <strong>{dict.donate.soonTitle}</strong>
          <p>{dict.donate.soonBody}</p>
          <p class="mt-2">
            <a class="btn dark" href={`tel:${org.phoneHref}`}>
              {dict.donate.soonCta}
              <Icon name="phone" size={16} />
            </a>
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- 3. Other ways to help -->
  <section class="section">
    <div class="container">
      <div class="section-head">
        <h2>{dict.donate.waysTitle}</h2>
      </div>
      <ol class="support-actions">
        {ways.map((way) => (
          <li>
            <div class="support-icon" aria-hidden="true"><Icon name={way.icon} size={26} /></div>
            <div>
              <h3>{way.title}</h3>
              <p>{way.body}</p>
              <a class="text-action" href={way.href}>
                {way.cta}<Icon name="arrow-right" size={18} />
              </a>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </section>
</Base>
