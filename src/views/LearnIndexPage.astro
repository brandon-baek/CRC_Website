---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import { t, localePath, type Locale } from '../i18n';
import { scamGuides } from '../data/scams';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const dict = t(locale);

const chipColors = ['red', 'yellow', '', 'yellow', '', 'red'] as const;
---
<Base
  locale={locale}
  title={dict.learn.pageTitle}
  description={dict.learn.pageLede}
  path="/learn"
>
  <header class="guide-hero">
    <div class="container inner">
      <h1>{dict.learn.pageTitle}</h1>
      <p class="tagline">{dict.learn.pageLede}</p>
    </div>
  </header>

  <section class="section">
    <div class="container">
      <h2 class="visually-hidden">{dict.learn.pageTitle}</h2>
      <div class="grid cols-2">
        {
          scamGuides.map((guide, i) => (
            <a class="card-hover" href={localePath(locale, `/learn/${guide.slug}`)}>
              <article class="card">
                <div class="guide-card-head">
                  <div class:list={['icon-chip', chipColors[i % chipColors.length]]} aria-hidden="true">
                    <Icon name={guide.icon as any} size={26} />
                  </div>
                  <div>
                    <h3>{guide.title[locale]}</h3>
                    <p class="muted">{guide.tagline[locale]}</p>
                  </div>
                </div>
                <p class="mt-2" style="font-weight:700;display:inline-flex;align-items:center;gap:0.4em;">
                  {dict.learn.readGuide}
                  <Icon name="arrow-right" size={18} />
                </p>
              </article>
            </a>
          ))
        }
      </div>
    </div>
  </section>
</Base>
