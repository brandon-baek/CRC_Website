---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import { t, localePath, type Locale } from '../i18n';
import { scamGuides } from '../data/scams';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const dict = t(locale);

---
<Base
  locale={locale}
  title={dict.learn.pageTitle}
  description={dict.learn.pageLede}
  path="/learn"
>
  <header class="guide-hero">
    <div class="container inner">
      <h1>{dict.learn.pageTitle}</h1>
      <p class="tagline">{dict.learn.pageLede}</p>
    </div>
  </header>

  <section class="section">
    <div class="container">
      <h2 class="visually-hidden">{dict.learn.pageTitle}</h2>
      <ol class="guide-index">
        {
          scamGuides.map((guide, i) => (
            <li>
              <a class="guide-index-link" href={localePath(locale, `/learn/${guide.slug}`)}>
                <span class="guide-number" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
                <span class="guide-index-icon" aria-hidden="true"><Icon name={guide.icon as any} size={26} /></span>
                <span class="guide-index-copy">
                  <strong>{guide.title[locale]}</strong>
                  <span>{guide.tagline[locale]}</span>
                </span>
                <span class="guide-index-action">{dict.learn.readGuide}<Icon name="arrow-right" size={18} /></span>
              </a>
            </li>
          ))
        }
      </ol>
    </div>
  </section>
</Base>
